+#!/usr/bin/env bash
+set -euo pipefail
+AGENT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
+cd "$AGENT_DIR"
+
+SECRET="$(grep '^LOCAL_AUTH_SECRET=' .env | cut -d= -f2-)"
+PORT="${OPENPAPER_SERVER_PORT:-8100}"
+HOST="${OPENPAPER_HOST:-192.168.1.20}"
+
+echo "Local login (open in the browser):"
+echo "  http://localhost:${PORT}/api/auth/local?secret=${SECRET}"
+echo "  http://${HOST}:${PORT}/api/auth/local?secret=${SECRET}"
+echo
+echo "This link sets the session cookie and redirects to the app."
diff --git a/scripts/login.sh b/scripts/login.sh
new file mode 100755
index 0000000..eae7df7
--- /dev/null
+++ b/scripts/login.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+AGENT_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
+cd "$AGENT_DIR"
+
+EMAIL="${1:-arthur@example.com}"
+NAME="${2:-Arthur}"
+USER_ID="11111111-1111-4111-8111-111111111111"
+SESSION_ID="$(cat /proc/sys/kernel/random/uuid)"
+TOKEN="$(openssl rand -hex 32)"
+CLIENT_PORT="${OPENPAPER_CLIENT_PORT:-3100}"
+
+docker compose --project-directory "$AGENT_DIR" -f "$AGENT_DIR/docker-compose.yml" exec -T openpaper-postgres psql -U postgres -d annotated-paper -v ON_ERROR_STOP=1 -q <<SQL
+INSERT INTO users (id, email, name, is_active, is_admin, is_blocked, auth_provider, provider_user_id, is_email_verified)
+VALUES ('$USER_ID', '$EMAIL', '$NAME', true, true, false, 'email', '$EMAIL', true)
+ON CONFLICT (id) DO UPDATE SET
+  email = EXCLUDED.email,
+  name = EXCLUDED.name,
+  is_active = true,
+  is_admin = true,
+  is_blocked = false,
+  is_email_verified = true;
+
+DELETE FROM sessions WHERE user_id = '$USER_ID' AND expires_at < now();
+
+INSERT INTO sessions (id, user_id, token, expires_at)
+VALUES ('$SESSION_ID', '$USER_ID', '$TOKEN', now() + interval '30 days');
+SQL
+
+cat <<EOF
+Open Paper: http://localhost:${CLIENT_PORT}
+
+Paste this in the browser console on that page, then reload:
+
+document.cookie = "session_token=${TOKEN}; path=/"; location.reload()
+
+Signed in as: ${EMAIL}
+EOF
diff --git a/server/app/api/auth_api.py b/server/app/api/auth_api.py
index 9d00bcb..1c79b97 100644
--- a/server/app/api/auth_api.py
+++ b/server/app/api/auth_api.py
@@ -90,6 +90,70 @@ async def get_me(
     return AuthResponse(success=True, message="User found", user=current_user)
 
 
+LOCAL_AUTH_SECRET = os.getenv("LOCAL_AUTH_SECRET")
+LOCAL_AUTH_EMAIL = os.getenv("LOCAL_AUTH_EMAIL", "arthur@example.com")
+LOCAL_AUTH_NAME = os.getenv("LOCAL_AUTH_NAME", "Arthur")
+
+
+@auth_router.get("/local")
+async def local_login(
+    secret: str = Query(...),
+    request: Request = None,
+    db: Session = Depends(get_db),
+):
+    """Secret-guarded login for self-hosted instances without a mail provider.
+
+    Disabled unless LOCAL_AUTH_SECRET is set. The secret is a bearer value, so
+    treat the link like a password.
+    """
+    if not LOCAL_AUTH_SECRET or not secrets.compare_digest(secret, LOCAL_AUTH_SECRET):
+        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND)
+
+    email = normalize_email(LOCAL_AUTH_EMAIL)
+    if not email:
+        raise HTTPException(status_code=status.HTTP_500_INTERNAL_SERVER_ERROR)
+
+    db_user = user_crud.get_by_email_and_provider(db, email=email, provider="email")
+    if not db_user:
+        db_user = user_crud.create_email_user(db, email=email, name=LOCAL_AUTH_NAME)
+        db_user = user_crud.verify_email(db, user=db_user)
+    elif not db_user.is_email_verified:
+        db_user = user_crud.verify_email(db, user=db_user)
+    if not db_user.is_active:
+        db_user.is_active = True
+        db.add(db_user)
+        db.commit()
+        db.refresh(db_user)
+
+    session = user_crud.create_session(
+        db=db,
+        user_id=db_user.id,
+        user_agent=request.headers.get("user-agent") if request else None,
+        ip_address=request.client.host if request and request.client else None,
+    )
+
+    # Keep the browser on the hostname it used to reach the API. A link opened
+    # via the LAN/Tailscale address must not redirect to localhost on the
+    # viewer's own machine.
+    redirect_base = client_domain
+    if request is not None:
+        request_host = (request.headers.get("host") or "").split(":")[0]
+        if request_host:
+            from urllib.parse import urlparse
+
+            parsed = urlparse(client_domain)
+            client_port = parsed.port or 3100
+            redirect_base = f"{request.url.scheme}://{request_host}:{client_port}"
+
+    response = RedirectResponse(
+        url=f"{redirect_base}/auth/callback?success=true", status_code=302
+    )
+    set_session_cookie(
+        response, token=str(session.token), expires_at=session.expires_at
+    )
+    return response
+
+
 @auth_router.patch("/profile", response_model=AuthResponse)
 async def update_profile(
     request: ProfileUpdateRequest,
